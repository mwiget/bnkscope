      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^tenant a\\b/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^tenant b\\b/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(total|both tenants)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8a8a85"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tmm-telemetry"
          },
          "expr": "label_replace(sum by (tenant, org) (rate(nginx_http_requests_total[10s])), \"name\", \"tenant $1\", \"tenant\", \"(.+)\")",
          "legendFormat": "{{name}} ({{org}})",
          "interval": "2s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tmm-telemetry"
          },
          "expr": "sum(rate(nginx_http_requests_total[10s]))",
          "legendFormat": "both tenants",
          "interval": "2s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tmm-telemetry"
      },
      "title": "Uplinks — p0 to the leaf, p1 to the other DPU",
      "description": "Link state of each DPU's two physical ports (ib_port_state of the uplink representors: 4 = up).",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "4": {
                  "text": "UP",
                  "color": "#0ca30c",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 3.99,
                "result": {
                  "text": "DOWN",
                  "color": "#d03b3b",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA",
                  "color": "#ec835a",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tmm-telemetry"
          },
          "expr": "label_replace(label_replace(ib_port_state{port=~\"p0|p1\",source=~\"$source\"}, \"who\", \"DPU $1\", \"source\", \".*-(..-..-..)\"), \"who\", \"tenant $1\", \"tenant\", \"(.+)\")",
          "legendFormat": "{{who}} {{dpu}} {{port}}",
          "interval": "2s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hardware path — traffic steered through the load balancer",
      "description": "Traffic steered through the load balancer, forwarded in hardware: bytes the DPU's embedded switch hands to TMM's external and internal service-function ports. Counted by the DPU, whether or not TMM's software ever sees the packet. Solid = from the clients, dashed = from the origins; grey = everything, the same line the panel on the right draws for scale. Drawn 5 s behind the other panels (DTS samples arrive late).",
      "datasource": {
        "type": "prometheus",
        "uid": "tmm-telemetry"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^tenant a\\b/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^tenant b\\b/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8a8a85"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [
                    2,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tmm-telemetry"
          },
          "expr": "label_replace(label_replace(rate(dts_eth_tx_bytes{leg=\"external\",source=~\"$source\"}[10s] offset 5s)*8, \"who\", \"DPU $1\", \"source\", \".*-(..-..-..)\"), \"who\", \"tenant $1\", \"tenant\", \"(.+)\")",
          "legendFormat": "{{who}} {{dpu}} · clients → LB (external leg)",
          "interval": "2s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tmm-telemetry"
          },
          "expr": "label_replace(label_replace(rate(dts_eth_tx_bytes{leg=\"internal\",source=~\"$source\"}[10s] offset 5s)*8, \"who\", \"DPU $1\", \"source\", \".*-(..-..-..)\"), \"who\", \"tenant $1\", \"tenant\", \"(.+)\")",
          "legendFormat": "{{who}} {{dpu}} · origins → LB (internal leg)",
          "interval": "2s"
        },
        {
          "refId": "C",
