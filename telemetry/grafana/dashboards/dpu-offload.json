      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tmm-telemetry"
          },
          "expr": "label_replace(label_replace(((sum by (node) (rate(f5tmm_virtual_server_clientside_bytes_in{node=~\"$source\"}[10s]) + rate(f5tmm_virtual_server_clientside_bytes_out{node=~\"$source\"}[10s]))*8) * on (node) group_left (tenant, dpu) group by (node, tenant, dpu) (label_replace(rate(dts_eth_rx_bytes{port=\"p0\"}[10s]), \"node\", \"$1\", \"source\", \"(.+)\")) or on (node) (sum by (node) (rate(f5tmm_virtual_server_clientside_bytes_in{node=~\"$source\"}[10s]) + rate(f5tmm_virtual_server_clientside_bytes_out{node=~\"$source\"}[10s]))*8)), \"who\", \"DPU $1\", \"node\", \".*-(..-..-..)\"), \"who\", \"tenant $1\", \"tenant\", \"(.+)\")",
