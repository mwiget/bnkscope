{
  "id": null,
  "uid": "dpu-offload",
  "title": "DPU offload — live",
  "description": "Hardware-offloaded throughput on BlueField DPUs (DOCA Telemetry Service) next to what TMM's software path sees, and requests/s at the origins. Needs a site scrape job: see telemetry/prometheus/scrape.d/dts.yml.example. Where that job puts a `tenant` label on a DPU's target (one tenant per DPU), every series of that DPU is named after the tenant.",
  "tags": [
    "tmm",
    "telemetry",
    "dpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "2s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "DPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tmm-telemetry"
        },
        "query": {
          "query": "label_values(dts_eth_rx_bytes, source)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "origin",
        "label": "Origin",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tmm-telemetry"
        },
        "query": {
          "query": "label_values(f5tmm_pool_member_serverside_tot_conns{port!=\"0\"}, addr)",
          "refId": "var"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 14,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;height:100%;font-size:14px\"><b>Load runner</b><a href=\"http://localhost:8099/run/show\" target=\"_blank\" rel=\"noopener\">show (Gbit/s, then requests/s)</a><a href=\"http://localhost:8099/run/gbps\" target=\"_blank\" rel=\"noopener\">Gbit/s only</a><a href=\"http://localhost:8099/run/rps\" target=\"_blank\" rel=\"noopener\">requests/s only</a><a href=\"http://localhost:8099/run/stop\" target=\"_blank\" rel=\"noopener\">stop</a><a href=\"http://localhost:8099/run/check\" target=\"_blank\" rel=\"noopener\">pre-flight check</a><a href=\"http://localhost:8099/\" target=\"_blank\" rel=\"noopener\">status / fail and heal a member</a><span style=\"opacity:.6\">opens the runner page in a new tab (rome1:8099 through the ssh tunnel)</span></div>"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tmm-telemetry"
      },
      "title": "Hardware path — through the load balancer",
      "description": "Bytes delivered to TMM's two service-function ports (external + internal leg), per DPU and summed. Read from the DPU's own port counters (DOCA Telemetry Service), not from TMM: established flows never reach TMM's software path. With one tenant per DPU, each value is that tenant's traffic. DTS samples arrive 2-5 s late, so these rates are taken over a 10 s window that ended 5 s ago.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^tenant a\\b/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^tenant b\\b/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(total|both tenants)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8a8a85"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tmm-telemetry"
          },
          "expr": "label_replace(label_replace(sum by (source, tenant, dpu) (rate(dts_eth_tx_bytes{leg=~\"external|internal\",source=~\"$source\"}[10s] offset 5s))*8, \"who\", \"DPU $1\", \"source\", \".*-(..-..-..)\"), \"who\", \"tenant $1\", \"tenant\", \"(.+)\")",
          "legendFormat": "{{who}} {{dpu}}",
          "interval": "2s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tmm-telemetry"
          },
          "expr": "sum(rate(dts_eth_tx_bytes{leg=~\"external|internal\",source=~\"$source\"}[10s] offset 5s))*8",
          "legendFormat": "total",
          "interval": "2s"
        }
      ]
    },
    {
      "id": 12,
