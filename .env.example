# bnkscope Environment Configuration
# ============================================================================
#
# NOTE: No .env file is needed! All settings are managed via docker-compose.yml
# environment variables and the UI (System > Defaults).
#
# This file documents optional environment variables you can set in
# docker-compose.yml under the backend service's `environment:` section.
#
# ============================================================================

# ============================================================================
# ALLOWED_ORIGINS - Who can access the API (CORS)
# ============================================================================
#
# Default: http://localhost,https://localhost,http://localhost:5173
#
# For production, set to your actual URL(s) in docker-compose.yml. Examples:
#
# Local laptop (the default — the UI is on 8080, the API on 8000):
#   ALLOWED_ORIGINS=http://localhost:8080
#
# Reachable from other machines (`./bnkscope up --listen 0.0.0.0` — read the
# security section of README.md first; there is no authentication):
#   ALLOWED_ORIGINS=http://localhost:8080,http://192.0.2.10:8080
#
# ALLOWED_ORIGINS=http://localhost:8080

# ============================================================================
# GUI UPGRADE (Required for System > Upgrade Now)
# ============================================================================
#
# Set HOST_REPO_PATH in docker-compose.yml to enable the GUI upgrade button.
# Without this, use SSH + ./upgrade.sh for server upgrades.
#
# HOST_REPO_PATH=/home/you/bnkscope

# ============================================================================
# ENVIRONMENT (development/staging/production)
# ============================================================================
#
# Set to 'production' to enforce security key validation at startup.
# Default: development (auto-generates keys without warnings)
#
# ENVIRONMENT=development

# ============================================================================
# MCP SERVER
# ============================================================================
#
# Read-only tools for an AI agent, on loopback. There is no service account:
# the backend has no authentication, so there is nothing for MCP to log in to.
#
# BNKSCOPE_MCP=on          # `./bnkscope up --no-mcp` to skip it
# MCP_PORT=8081
# MCP_LOG_LEVEL=INFO
