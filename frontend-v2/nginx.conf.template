# bnkscope frontend — serves the SPA and proxies /api and /ws to the backend.
#
# The nginx proxy container this used to sit behind went with bnkscope Phase 4;
# these blocks are the only path to the API now, not a fallback.
#
# Rendered by the nginx image's own envsubst entrypoint at container start
# (see /docker-entrypoint.d/20-envsubst-on-templates.sh), so the listen port
# and the upstream follow the environment. Two reasons both must be settable:
# under network_mode: host bnkscope shares the port space with everything else
# on the box, and under the macOS/WSL2 bridge overlay the backend is reached by
# its compose service name rather than over loopback.
server {
    # Address:port, not just port. This is the front door — it proxies /api
    # through to an API that has no authentication — so it binds 127.0.0.1
    # unless someone deliberately asks otherwise (`bnkscope up --listen`).
    listen ${BNKSCOPE_UI_BIND}:${BNKSCOPE_UI_PORT};
    server_name _;  # Accept any hostname for portability
    root /usr/share/nginx/html;
    index index.html;

    # SEC-005: Hide nginx version
    server_tokens off;

    # Main app - SPA fallback to index.html
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri $uri/ /index.html;
    }

    # Static assets — long cache with immutable hint
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://${BNKSCOPE_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for long-running reads (a slow cluster, a large log fetch).
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Disable buffering for real-time streaming
        proxy_buffering off;
    }

    # WebSocket proxy for real-time features (logs, exec, etc.)
    location /ws/ {
        proxy_pass http://${BNKSCOPE_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket specific timeouts
        proxy_connect_timeout 7d;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;
    }
}
